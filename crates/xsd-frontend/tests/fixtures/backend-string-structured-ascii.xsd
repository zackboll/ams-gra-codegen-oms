<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:structured" targetNamespace="urn:test:structured"
           elementFormDefault="qualified">
  <xs:simpleType name="Imo"><xs:restriction base="xs:string">
    <xs:length value="10"/><xs:pattern value="IMO[0-9]{7}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Prf"><xs:restriction base="xs:string">
    <xs:minLength value="3"/><xs:maxLength value="4"/><xs:pattern value="1?[1-7][1-8]{2}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="FileName"><xs:restriction base="xs:string">
    <xs:minLength value="1"/><xs:maxLength value="255"/><xs:pattern value="[a-zA-Z0-9_\-]+\.[a-zA-Z0-9_\.\-]+"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Cycle"><xs:restriction base="xs:string">
    <xs:minLength value="7"/><xs:maxLength value="8"/><xs:pattern value="[A-Z0-9]{2}-[0-9]{4}[TE]?"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Model"><xs:restriction base="xs:string">
    <xs:maxLength value="4"/><xs:pattern value="[A-Za-z0-9]{1,4}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Single"><xs:restriction base="xs:string">
    <xs:length value="1"/><xs:pattern value="[0-9]"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Octal"><xs:restriction base="xs:string">
    <xs:minLength value="1"/><xs:maxLength value="16"/><xs:pattern value="[0-7]+"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Niirs"><xs:restriction base="xs:string">
    <xs:length value="3"/><xs:pattern value="[0-9]\.[0-9]"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Track"><xs:restriction base="xs:string">
    <xs:length value="5"/><xs:pattern value="[A-HJ-NP-Z0-7]{2}[0-7]{3}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="SpaceCode"><xs:restriction base="xs:string">
    <xs:length value="1"/><xs:pattern value="[ODM ]"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Designator"><xs:restriction base="xs:string">
    <xs:maxLength value="16"/><xs:pattern value="[a-zA-Z0-9 \-_]{1,16}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Emitter"><xs:restriction base="xs:string">
    <xs:maxLength value="14"/><xs:pattern value="[a-zA-Z0-9]{5}[0-9]{9}"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="Payload"><xs:sequence>
    <xs:element name="required" type="t:Imo"/>
    <xs:element name="optional" type="t:Prf" minOccurs="0"/>
    <xs:element name="bounded" type="t:FileName" minOccurs="0" maxOccurs="3"/>
    <xs:element name="unbounded" type="t:Octal" minOccurs="0" maxOccurs="unbounded"/>
  </xs:sequence></xs:complexType>
</xs:schema>