<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:private-extension-overlay"
           targetNamespace="urn:private-extension-overlay"
           elementFormDefault="qualified">
  <!-- The public half: an abstract extension point with no concrete
       descendant of its own, referenced as a repeated (0..unbounded) VALUE. -->
  <xs:complexType name="ExtensionBase" abstract="true">
    <xs:sequence>
      <xs:element name="Label" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Container">
    <xs:sequence>
      <xs:element name="Name" type="xs:string"/>
      <xs:element name="ExtensionCommand" type="t:ExtensionBase"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
