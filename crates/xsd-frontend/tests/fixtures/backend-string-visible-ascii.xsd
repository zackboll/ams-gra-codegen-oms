<?xml version="1.0" encoding="UTF-8"?>
<!--
  Task 039 backend fixture: the supported visible-ASCII String family, plus a
  Task 034 optional-named composition and an ordinary String control.

  The declaration names here are deliberately NOT UCI's `VisibleString256Type`:
  support must arise from PrimitiveKind::String plus the effective
  ConstraintSet, so a differently spelled declaration with the same profile
  must be equally renderable. Authoritative UCI evidence makes the same point
  from the other direction: two real members, `AttributedURI_Type` and
  `MIME_Type`, do not mention "VisibleString" at all.

  The facets of `Callsign` are byte-identical to the authoritative UCI
  declaration `VisibleString256Type`:
    UCI 2.5 UCI_MessageDefinitions_v2_5_0.xsd:146232
    UCI 2.6 UCI_MessageDefinitions_v2_6_0.xsd:146583

  Note that the pattern is written here with the SAME XML character references
  the pinned XSD uses. The parser expands them, so the normalized IR carries the
  literal characters `[ -~]` either way; spelling it this way keeps the fixture
  a faithful copy of the authoritative bytes.

  The target namespace deliberately does not end in `string`: a generated Ada
  child package whose final namespace component is `String` can shadow
  Standard.String, which is a pre-existing generator hazard outside this
  fixture's scope.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:callsign"
           targetNamespace="urn:test:callsign"
           elementFormDefault="qualified">

  <!-- The authoritative 1..256 UCI profile, under a non-UCI name. -->
  <xs:simpleType name="Callsign">
    <xs:annotation>
      <xs:documentation>A string representing up to 256 characters in length, restricted to visible characters (0x20-0x7E).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="256"/>
      <xs:pattern value="[&#x20;-&#x7E;]{1,256}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A SECOND member with DIFFERENT bounds. This is what proves the profile is
       genuinely parameterized: the generated carrier must enforce 1..32 here,
       not the 1..256 of the declaration above. UCI really does contain members
       at 20, 32, 64, 81, 128, 256, 480, 512 and 1024. -->
  <xs:simpleType name="ShortLabel">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="32"/>
      <xs:pattern value="[&#x20;-&#x7E;]{1,32}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A member whose minLength is NOT 1, mirroring UCI's VisibleString2_4Type.
       The empty string and a single character must both be rejected here while
       remaining acceptable to a 1..N member in the same unit. -->
  <xs:simpleType name="CountryCode">
    <xs:restriction base="xs:string">
      <xs:minLength value="2"/>
      <xs:maxLength value="4"/>
      <xs:pattern value="[&#x20;-&#x7E;]{2,4}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A transitive member: a restriction of a member that adds no facets, the
       shape UCI's MissionCategoryType has over VisibleString32Type. Task 015
       resolves the chain, so the effective constraint set reaching the
       classifier is the one above and this must be equally renderable. -->
  <xs:simpleType name="DerivedLabel">
    <xs:restriction base="t:ShortLabel"/>
  </xs:simpleType>

  <!-- Task 037 and Task 038 carriers, so all three String profiles are proven
       to coexist in one generated unit. In Ada this puts several
       `Create (Value : String) return <different type>` overloads in the same
       package. -->
  <xs:simpleType name="SchemaVersion">
    <xs:restriction base="xs:string">
      <xs:minLength value="7"/>
      <xs:maxLength value="57"/>
      <xs:pattern value="[0-9]{3}\.[0-9]{1,2}(\.[0-9]{1,2})([a-z]{1,2})?(_[a-zA-Z0-9\-]{1,45})?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Uuid">
    <xs:restriction base="xs:string">
      <xs:length value="36"/>
      <xs:pattern value="(0{8}(-0{4}){3}-0{12})|([a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-5][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12})"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Task 034 composition: an optional NAMED occurrence of a supported String
       profile must compose automatically, with no optional-String special case
       anywhere. `Notes` is an ordinary unconstrained String, which must keep
       its existing plain representation in every backend. -->
  <xs:complexType name="Payload">
    <xs:sequence>
      <xs:element name="Primary" type="t:Callsign"/>
      <xs:element name="Alternate" type="t:Callsign" minOccurs="0"/>
      <xs:element name="Label" type="t:ShortLabel" minOccurs="0"/>
      <xs:element name="Country" type="t:CountryCode"/>
      <xs:element name="Derived" type="t:DerivedLabel"/>
      <xs:element name="Version" type="t:SchemaVersion"/>
      <xs:element name="Identifier" type="t:Uuid"/>
      <xs:element name="Notes" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
