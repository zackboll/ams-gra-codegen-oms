<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:pub="urn:overlay"
           targetNamespace="urn:overlay"
           elementFormDefault="qualified">
  <!-- Task 029 section 14: the primary root declares a named simple
       restriction that an overlay further restricts. -->
  <xs:simpleType name="RootBoundedInt">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="100"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
