<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:overlay"
           targetNamespace="urn:overlay"
           elementFormDefault="qualified">
  <!-- Task 029 sections 16 and 35: an overlay that redeclares a qualified name
       already present in the primary root. Overlays are additive only, so this
       must fail existing duplicate-type validation rather than override,
       shadow, or win by being last. -->
  <xs:complexType name="Container">
    <xs:sequence>
      <xs:element name="Name" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
