with "aht";
project OMS_WebSocket_Dependencies is
   WS := external ("OMS_WS_CODEC_SOURCE");
   for Source_Dirs use (WS & "/src");
   --  AHT owns both framing and TLS units exactly once. Only the selected
   --  backend is compiled; no high-level AHT client is elaborated here.
   for Source_Files use
     ("websocket.ads", "websocket-handshake.ads", "websocket-handshake.adb",
      "websocket-base64.ads", "websocket-base64.adb");
   for Object_Dir use "obj-websocket-dependencies";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnato", "-O0");
   end Compiler;
end OMS_WebSocket_Dependencies;