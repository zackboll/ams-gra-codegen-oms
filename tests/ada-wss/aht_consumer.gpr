with "aht";
project AHT_Consumer is
   for Source_Dirs use (".");
   for Object_Dir use "obj-" & external ("AHT_TLS_BACKEND", "openssl");
   for Exec_Dir use "bin-" & external ("AHT_TLS_BACKEND", "openssl");
   for Main use ("aht_probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O0");
   end Compiler;
end AHT_Consumer;