<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:t="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified" version="002.5.0">
  <!-- Authored synthetic service; not an authentic complete UCI message. -->
  <xs:simpleType name="NITF_DateAndTimeType"><xs:restriction base="xs:string">
    <xs:length value="12"/>
    <xs:pattern value="(([12]\d\d\d)((0[1-9])|(1[012]))(0[1-9]|[12][0-9]|3[01])([01][0-9]|[2][0-3])([0-5][0-9]))"/>
    <xs:pattern value=" {12}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="NITF_DateType"><xs:restriction base="xs:string">
    <xs:length value="8"/>
    <xs:pattern value="([12]\d\d\d((0[1-9])|(1[012]))(0[1-9]|[12][0-9]|3[01]))"/>
    <xs:pattern value=" {8}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="NITF_MSTGTA_TargetLocationType"><xs:restriction base="xs:string">
    <xs:length value="21"/>
    <xs:pattern value="([0-8]\d([0-5]\d){2}\.\d{2}(N|S)(0\d{2}|1[0-7]\d)([0-5]\d){2}\.\d{2}(E|W))"/>
    <xs:pattern value="([\+\-]{1}[0-8]\d\.\d{6}[\+\-]{1}(0\d{2}|1[0-7]\d)\.\d{6})"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Derived"><xs:restriction base="t:NITF_DateType"/></xs:simpleType>
  <xs:simpleType name="Leaf"><xs:restriction base="t:Derived"/></xs:simpleType>
  <xs:complexType name="EntryType"><xs:sequence>
    <xs:element name="Date" type="t:NITF_DateType"/>
    <xs:element name="Time" type="t:NITF_DateAndTimeType"/>
    <xs:element name="Location" type="t:NITF_MSTGTA_TargetLocationType"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Selection"><xs:choice>
    <xs:element name="Entry" type="t:EntryType"/>
    <xs:element name="Date" type="t:Leaf"/>
  </xs:choice></xs:complexType>
  <xs:complexType name="Payload"><xs:sequence>
    <xs:element name="Required" type="t:NITF_DateType"/>
    <xs:element name="Entry" type="t:EntryType" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Selected" type="t:Selection"/>
  </xs:sequence></xs:complexType>
  <xs:element name="UnicodeNotice" type="t:Payload" t:version="002.5.0"/>
</xs:schema>