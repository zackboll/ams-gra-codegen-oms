<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:t="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified" version="002.5.0">
  <!-- Independent synthetic qualification, not a complete UCI service. -->
  <xs:simpleType name="Instant"><xs:restriction base="xs:dateTime"><xs:pattern value=".+Z"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Restricted"><xs:restriction base="t:Instant"/></xs:simpleType>
  <xs:complexType name="Ancestor" abstract="true"><xs:sequence>
    <xs:element name="Inherited" type="xs:dateTime"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Nested"><xs:sequence>
    <xs:element name="Value" type="t:Instant"/>
    <xs:element name="Directs" type="xs:dateTime" minOccurs="0" maxOccurs="3"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Payload"><xs:complexContent><xs:extension base="t:Ancestor"><xs:sequence>
    <xs:element name="Direct" type="xs:dateTime"/>
    <xs:element name="Named" type="t:Instant"/>
    <xs:element name="Optional" type="xs:dateTime" minOccurs="0"/>
    <xs:element name="Values" type="t:Instant" minOccurs="1" maxOccurs="3"/>
    <xs:element name="Nested" type="t:Nested"/>
    <xs:element name="Restricted" type="t:Restricted" minOccurs="0"/>
  </xs:sequence></xs:extension></xs:complexContent></xs:complexType>
  <xs:element name="DateNotice" type="t:Payload" t:version="001.000.000.000"/>
</xs:schema>
