<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:t="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified" version="002.5.0">
  <!-- Synthetic structural sum qualification; not an authentic UCI service. -->
  <xs:simpleType name="Country"><xs:restriction base="xs:string">
    <xs:enumeration value="USA"/><xs:enumeration value="GBR"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Words"><xs:restriction base="xs:string">
    <xs:minLength value="6"/><xs:maxLength value="261"/><xs:pattern value="NATO:[a-zA-Z\-_]{1,256}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="Octets"><xs:restriction base="xs:hexBinary"/></xs:simpleType>
  <xs:complexType name="Detail"><xs:sequence>
    <xs:element name="Count" type="xs:unsignedInt"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Owner"><xs:choice>
    <xs:element name="GovernmentIdentifier" type="t:Country"/>
    <xs:element name="NATO_SpecialWord" type="t:Words"/>
  </xs:choice></xs:complexType>
  <xs:complexType name="Selection"><xs:choice>
    <xs:element name="Text" type="xs:string"/>
    <xs:element name="OtherText" type="xs:string"/>
    <xs:element name="Number" type="xs:int"/>
    <xs:element name="Binary" type="t:Octets"/>
    <xs:element name="DirectBinary" type="xs:hexBinary"/>
    <xs:element name="When" type="xs:dateTime"/>
    <xs:element name="Span" type="xs:duration"/>
    <xs:element name="Record" type="t:Detail"/>
    <xs:element name="OtherRecord" type="t:Detail"/>
    <xs:element name="Nested" type="t:Owner"/>
    <xs:element name="class" type="xs:string"/>
  </xs:choice></xs:complexType>
  <xs:complexType name="Ancestor" abstract="true"><xs:sequence>
    <xs:element name="Inherited" type="t:Owner" minOccurs="0" maxOccurs="unbounded"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Payload"><xs:complexContent><xs:extension base="t:Ancestor"><xs:sequence>
    <xs:element name="Required" type="t:Selection"/>
    <xs:element name="Optional" type="t:Owner" minOccurs="0"/>
    <xs:element name="Bounded" type="t:Owner" minOccurs="0" maxOccurs="3"/>
    <xs:element name="Repeated" type="t:Selection" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Positive" type="t:Owner" minOccurs="1" maxOccurs="unbounded"/>
  </xs:sequence></xs:extension></xs:complexContent></xs:complexType>
  <xs:element name="ChoiceNotice" type="t:Payload" t:version="001.000.000.000"/>
</xs:schema>