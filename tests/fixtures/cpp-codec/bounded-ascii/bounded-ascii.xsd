<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
           targetNamespace="https://www.vdl.afrl.af.mil/programs/oam"
           elementFormDefault="qualified"
           version="000.1.0">
  <!-- SYNTHETIC CPP-OMS-005 fixture (OAM namespace; not UCI). Every
       constrained String below is one pinned Task 058 bounded-ASCII row
       (codegen-core string_profile UCI_BOUNDED_ASCII_PROFILES) under a
       non-UCI name, so it exercises the C++ codec over:

         EmptyMarkerType  [a-zA-Z]{0}             length 0       (EmptyType shape)
         TailType         [A-Z0-9 ]{8}            length 8       fixed, SPACE member
         CodeType         [a-zA-Z0-9]{4}          length 4       fixed alphanumeric
         NameType         [a-zA-Z0-9]{1,20}       1..20          bounded alphanumeric
         LabelType        [a-zA-Z0-9 \-_]{1,20}   1..20          space / hyphen / underscore
         MissionType      [\-\.,\(\)\?A-Z0-9 ]{1,8}  1..8        USMTF punctuation
         UnitNameType     [a-zA-Z0-9 '\(\).,@;+\-]{1,256} 1..256 apostrophe / @ / ; / +
         SerialType       USMTF serial class      1..7           includes " \ & < > (JSON escapes)
         PinType          [0-9]{4,5}              4..5           minLength > 1
         OctalType        [0-7]{4}                length 4       sub-range of digits
         VisibleType      [ -~]{6}                length 6       visible ASCII range
         LaunchType       [A-Z]{1,3}              1..3           upper letters

       Shapes: required, optional (including the optional zero-length
       UnassignAll), bounded repetition 0..3 and 2..4, unbounded repetition,
       a required single Choice whose alternatives are bounded-ASCII values,
       a repeated Choice, and a nested Record. BoundedNotice is subscribed
       and published on one topic. -->
  <xs:simpleType name="EmptyMarkerType">
    <xs:restriction base="xs:string">
      <xs:length value="0"/>
      <xs:pattern value="[a-zA-Z]{0}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TailType">
    <xs:restriction base="xs:string">
      <xs:length value="8"/>
      <xs:pattern value="[A-Z0-9&#x20;]{8}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CodeType">
    <xs:restriction base="xs:string">
      <xs:length value="4"/>
      <xs:pattern value="[a-zA-Z0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="NameType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="20"/>
      <xs:pattern value="[a-zA-Z0-9]{1,20}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="LabelType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="20"/>
      <xs:pattern value="[a-zA-Z0-9&#x20;\-_]{1,20}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MissionType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="8"/>
      <xs:pattern value="[\-\.,\(\)\?A-Z0-9 ]{1,8}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitNameType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="256"/>
      <xs:pattern value="[a-zA-Z0-9 '\(\).,@;+\-]{1,256}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SerialType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="7"/>
      <xs:pattern value="[\-A-Z0-9 \.,\(\)&amp;\?!@#$%\^\*=_\+\[\]\{\}\\&quot;';&gt;&lt;~`\|]{1,7}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PinType">
    <xs:restriction base="xs:string">
      <xs:minLength value="4"/>
      <xs:maxLength value="5"/>
      <xs:pattern value="[0-9]{4,5}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OctalType">
    <xs:restriction base="xs:string">
      <xs:length value="4"/>
      <xs:pattern value="[0-7]{4}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VisibleType">
    <xs:restriction base="xs:string">
      <xs:length value="6"/>
      <xs:pattern value="[ -~]{6}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="LaunchType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="3"/>
      <xs:pattern value="[A-Z]{1,3}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="PickChoice">
    <xs:choice>
      <xs:element name="Launch" type="uci:LaunchType"/>
      <xs:element name="Empty" type="uci:EmptyMarkerType"/>
      <xs:element name="Serial" type="uci:SerialType"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="InnerType">
    <xs:sequence>
      <xs:element name="Tail" type="uci:TailType"/>
      <xs:element name="Unassign" type="uci:EmptyMarkerType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="BoundedPayloadType">
    <xs:sequence>
      <xs:element name="Marker" type="uci:EmptyMarkerType"/>
      <xs:element name="UnassignAll" type="uci:EmptyMarkerType" minOccurs="0"/>
      <xs:element name="Tail" type="uci:TailType"/>
      <xs:element name="Code" type="uci:CodeType"/>
      <xs:element name="Name" type="uci:NameType" minOccurs="0"/>
      <xs:element name="Label" type="uci:LabelType" minOccurs="0"/>
      <xs:element name="Mission" type="uci:MissionType" minOccurs="0"/>
      <xs:element name="UnitName" type="uci:UnitNameType" minOccurs="0"/>
      <xs:element name="Serial" type="uci:SerialType" minOccurs="0"/>
      <xs:element name="Pin" type="uci:PinType" minOccurs="0"/>
      <xs:element name="Octal" type="uci:OctalType" minOccurs="0"/>
      <xs:element name="Visible" type="uci:VisibleType" minOccurs="0"/>
      <xs:element name="Markers" type="uci:EmptyMarkerType" minOccurs="0" maxOccurs="3"/>
      <xs:element name="Names" type="uci:NameType" minOccurs="2" maxOccurs="4"/>
      <xs:element name="Codes" type="uci:CodeType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Pick" type="uci:PickChoice"/>
      <xs:element name="Picks" type="uci:PickChoice" minOccurs="0" maxOccurs="2"/>
      <xs:element name="Inner" type="uci:InnerType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="BoundedNotice" type="uci:BoundedPayloadType" uci:version="001.000.000.000"/>
</xs:schema>
