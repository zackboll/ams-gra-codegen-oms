  </xs:sequence></xs:extension></xs:complexContent></xs:complexType>
  <xs:complexType name="Sibling"><xs:complexContent><xs:extension base="t:Base"><xs:sequence><xs:element name="Other" type="xs:boolean"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
  <xs:element name="InheritedNotice" type="t:Leaf" t:version="001.000.000.000"/>
  <xs:element name="SiblingNotice" type="t:Sibling" t:version="001.000.000.000"/>
</xs:schema>