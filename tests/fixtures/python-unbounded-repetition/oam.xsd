<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:t="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified" version="002.5.0">
  <xs:simpleType name="Word"><xs:restriction base="xs:string"><xs:minLength value="6"/><xs:maxLength value="261"/><xs:pattern value="NATO:[a-zA-Z\-_]{1,256}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Visible"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="20"/><xs:pattern value="[ -~]{1,20}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Instant"><xs:restriction base="xs:dateTime"><xs:pattern value=".+Z"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="State"><xs:restriction base="xs:string"><xs:enumeration value="ON"/><xs:enumeration value="OFF"/></xs:restriction></xs:simpleType>
  <xs:complexType name="Ancestor" abstract="true"><xs:sequence>
    <xs:element name="Inherited-Values" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Child"><xs:sequence>
    <xs:element name="Words" type="t:Word" minOccurs="1" maxOccurs="unbounded"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Group"><xs:sequence>
    <xs:element name="Children" type="t:Child" minOccurs="0" maxOccurs="unbounded"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Payload"><xs:complexContent><xs:extension base="t:Ancestor"><xs:sequence>
    <xs:element name="Required" type="xs:int" minOccurs="1" maxOccurs="unbounded"/>
    <xs:element name="At-Least-Three" type="xs:string" minOccurs="3" maxOccurs="unbounded"/>
    <xs:element name="Strings" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Flags" type="xs:boolean" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Integers" type="xs:integer" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Unsigned" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Floats" type="xs:double" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Times" type="xs:dateTime" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Instants" type="t:Instant" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Words" type="t:Word" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Visible" type="t:Visible" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="States" type="t:State" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Groups" type="t:Group" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Bounded" type="xs:int" minOccurs="0" maxOccurs="3"/>
  </xs:sequence></xs:extension></xs:complexContent></xs:complexType>
  <xs:element name="SequenceNotice" type="t:Payload" t:version="001.000.000.000"/>
</xs:schema>