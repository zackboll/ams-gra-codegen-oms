<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
 <xs:simpleType name="Span"><xs:restriction base="xs:duration"/></xs:simpleType>
 <xs:simpleType name="Digest"><xs:restriction base="xs:hexBinary"><xs:length value="2"/></xs:restriction></xs:simpleType>
 <xs:complexType name="Details"><xs:sequence>
  <xs:element name="Dates" type="xs:dateTime" minOccurs="0" maxOccurs="3"/>
  <xs:element name="Spans" type="uci:Span" minOccurs="0" maxOccurs="unbounded"/>
  <xs:element name="Data" type="xs:hexBinary"/>
  <xs:element name="Hash" type="uci:Digest" minOccurs="0"/>
 </xs:sequence></xs:complexType>
 <xs:complexType name="Selection"><xs:choice>
  <xs:element name="Nested" type="uci:Details"/>
  <xs:element name="Enabled" type="xs:boolean"/>
 </xs:choice></xs:complexType>
 <xs:complexType name="Combined"><xs:sequence>
  <xs:element name="Picks" type="uci:Selection" minOccurs="0" maxOccurs="3"/>
 </xs:sequence></xs:complexType>
 <xs:element name="BinaryTemporalNotice" type="uci:Combined" uci:version="001.000.000.000"/>
</xs:schema>