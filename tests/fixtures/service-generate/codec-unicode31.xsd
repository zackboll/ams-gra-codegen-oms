<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam" targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
<xs:simpleType name="StampValue"><xs:restriction base="xs:string"><xs:length value="12"/>
<xs:pattern value="(([12]\d\d\d)((0[1-9])|(1[012]))(0[1-9]|[12][0-9]|3[01])([01][0-9]|[2][0-3])([0-5][0-9]))"/>
<xs:pattern value=" {12}"/>
</xs:restriction></xs:simpleType>
<xs:simpleType name="DayValue"><xs:restriction base="xs:string"><xs:length value="8"/>
<xs:pattern value="([12]\d\d\d((0[1-9])|(1[012]))(0[1-9]|[12][0-9]|3[01]))"/>
<xs:pattern value=" {8}"/>
</xs:restriction></xs:simpleType>
<xs:simpleType name="LocationValue"><xs:restriction base="xs:string"><xs:length value="21"/>
<xs:pattern value="([0-8]\d([0-5]\d){2}\.\d{2}(N|S)(0\d{2}|1[0-7]\d)([0-5]\d){2}\.\d{2}(E|W))"/>
<xs:pattern value="([\+\-]{1}[0-8]\d\.\d{6}[\+\-]{1}(0\d{2}|1[0-7]\d)\.\d{6})"/>
</xs:restriction></xs:simpleType>
<xs:complexType name="UnicodeSelection"><xs:choice><xs:element name="Date" type="uci:DayValue"/><xs:element name="Position" type="uci:LocationValue"/></xs:choice></xs:complexType>
<xs:complexType name="UnicodePayload"><xs:sequence><xs:element name="Stamp" type="uci:StampValue"/><xs:element name="Day" type="uci:DayValue"/><xs:element name="Location" type="uci:LocationValue"/><xs:element name="Optional" type="uci:DayValue" minOccurs="0"/><xs:element name="Repeated" type="uci:DayValue" minOccurs="0" maxOccurs="unbounded"/><xs:element name="Selection" type="uci:UnicodeSelection"/></xs:sequence></xs:complexType>
<xs:element name="UnicodeNotice" type="uci:UnicodePayload" uci:version="001.000.000.000"/>
</xs:schema>
