<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
 <xs:simpleType name="Instant"><xs:restriction base="xs:dateTime"><xs:pattern value=".+Z"/></xs:restriction></xs:simpleType>
 <xs:simpleType name="Span"><xs:restriction base="xs:duration"/></xs:simpleType>
 <xs:complexType name="Base"><xs:sequence>
  <xs:element name="InheritedDates" type="uci:Instant" minOccurs="1" maxOccurs="3"/>
 </xs:sequence></xs:complexType>
 <xs:complexType name="Details"><xs:sequence>
  <xs:element name="Dates" type="xs:dateTime" minOccurs="0" maxOccurs="3"/>
  <xs:element name="Spans" type="uci:Span" minOccurs="2" maxOccurs="unbounded"/>
 </xs:sequence></xs:complexType>
 <xs:complexType name="Selection"><xs:choice>
  <xs:element name="Nested" type="uci:Details"/>
  <xs:element name="Enabled" type="xs:boolean"/>
 </xs:choice></xs:complexType>
 <xs:complexType name="Composition"><xs:complexContent><xs:extension base="uci:Base"><xs:sequence>
  <xs:element name="Date" type="xs:dateTime"/>
  <xs:element name="Duration" type="xs:duration"/>
  <xs:element name="Child" type="uci:Details"/>
  <xs:element name="Pick" type="uci:Selection"/>
 </xs:sequence></xs:extension></xs:complexContent></xs:complexType>
 <xs:element name="TemporalNotice" type="uci:Composition" uci:version="001.000.000.000"/>
</xs:schema>