<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
 <xs:simpleType name="Digest"><xs:restriction base="xs:hexBinary"><xs:minLength value="1"/><xs:maxLength value="2"/></xs:restriction></xs:simpleType>
 <xs:simpleType name="EmptyDigest"><xs:restriction base="xs:hexBinary"><xs:length value="0"/></xs:restriction></xs:simpleType>
 <xs:simpleType name="ExactDigest"><xs:restriction base="xs:hexBinary"><xs:length value="2"/></xs:restriction></xs:simpleType>
 <xs:complexType name="Base"><xs:sequence><xs:element name="Inherited" type="xs:double"/></xs:sequence></xs:complexType>
 <xs:complexType name="Leaf"><xs:sequence>
  <xs:element name="Data" type="xs:hexBinary"/>
  <xs:element name="Digest" type="uci:Digest"/>
  <xs:element name="OptionalDigest" type="uci:Digest" minOccurs="0"/>
  <xs:element name="Digests" type="uci:Digest" minOccurs="0" maxOccurs="unbounded"/>
  <xs:element name="Exact" type="uci:ExactDigest"/>
  <xs:element name="Empty" type="uci:EmptyDigest"/>
 </xs:sequence></xs:complexType>
 <xs:complexType name="Reading"><xs:complexContent><xs:extension base="uci:Base"><xs:sequence>
  <xs:element name="Direct" type="xs:double"/>
  <xs:element name="Single" type="xs:float"/>
  <xs:element name="Text" type="xs:string"/>
  <xs:element name="Nested" type="uci:Leaf"/>
  <xs:element name="Dates" type="xs:dateTime" minOccurs="0" maxOccurs="unbounded"/>
  <xs:element name="Spans" type="xs:duration" minOccurs="0" maxOccurs="3"/>
 </xs:sequence></xs:extension></xs:complexContent></xs:complexType>
 <xs:complexType name="Pick"><xs:choice>
  <xs:element name="Nested" type="uci:Reading"/>
  <xs:element name="Enabled" type="xs:boolean"/>
 </xs:choice></xs:complexType>
 <xs:complexType name="LosslessEnvelope"><xs:sequence>
  <xs:element name="Record" type="uci:Reading"/>
  <xs:element name="Pick" type="uci:Pick"/>
  <xs:element name="Picks" type="uci:Pick" minOccurs="1" maxOccurs="3"/>
  <xs:element name="UB0" type="uci:Reading" minOccurs="0" maxOccurs="unbounded"/>
  <xs:element name="UB1" type="uci:Reading" minOccurs="1" maxOccurs="unbounded"/>
  <xs:element name="B0" type="uci:Reading" minOccurs="0" maxOccurs="3"/>
  <xs:element name="B1" type="uci:Reading" minOccurs="1" maxOccurs="3"/>
 </xs:sequence></xs:complexType>
 <xs:element name="Float64Notice" type="uci:LosslessEnvelope" uci:version="001.000.000.000"/>
</xs:schema>