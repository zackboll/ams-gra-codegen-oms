<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
 <xs:simpleType name="TargetGet"><xs:restriction base="xs:double"><xs:minInclusive value="-1"/><xs:maxExclusive value="1"/></xs:restriction></xs:simpleType>
 <xs:simpleType name="Array_Encode_Hex_Binary"><xs:restriction base="xs:double"/></xs:simpleType>
 <xs:complexType name="PathLength"><xs:sequence>
  <xs:element name="Direct" type="xs:double"/>
  <xs:element name="Optional" type="xs:double" minOccurs="0"/>
  <xs:element name="Named" type="uci:Array_Encode_Hex_Binary"/>
  <xs:element name="Checked" type="uci:TargetGet"/>
  <xs:element name="Data" type="xs:hexBinary"/>
  <xs:element name="Single" type="xs:float"/>
  <xs:element name="Samples" type="xs:double" minOccurs="0" maxOccurs="3"/>
  <xs:element name="NamedSamples" type="uci:TargetGet" minOccurs="1" maxOccurs="unbounded"/>
 </xs:sequence></xs:complexType>
 <xs:complexType name="ArraySample"><xs:choice>
  <xs:element name="Nested" type="uci:PathLength"/>
  <xs:element name="Enabled" type="xs:boolean"/>
 </xs:choice></xs:complexType>
 <xs:complexType name="LosslessEnvelope"><xs:sequence>
  <xs:element name="Record" type="uci:PathLength"/>
  <xs:element name="Pick" type="uci:ArraySample"/>
  <xs:element name="Picks" type="uci:ArraySample" minOccurs="1" maxOccurs="3"/>
 </xs:sequence></xs:complexType>
 <xs:element name="Float64Notice" type="uci:LosslessEnvelope" uci:version="001.000.000.000"/>
</xs:schema>