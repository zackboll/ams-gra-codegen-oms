<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
 <xs:simpleType name="Span"><xs:restriction base="xs:duration"/></xs:simpleType>
 <xs:simpleType name="Digest"><xs:restriction base="xs:hexBinary"><xs:minLength value="2"/><xs:maxLength value="3"/></xs:restriction></xs:simpleType>
 <xs:simpleType name="Blob"><xs:restriction base="xs:hexBinary"/></xs:simpleType>
 <xs:simpleType name="TargetGet"><xs:restriction base="xs:float"><xs:minInclusive value="-1"/><xs:maxInclusive value="1"/></xs:restriction></xs:simpleType>
 <xs:complexType name="PathLength"><xs:sequence>
  <xs:element name="Dates" type="xs:dateTime" minOccurs="0" maxOccurs="3"/>
  <xs:element name="Spans" type="uci:Span" minOccurs="0" maxOccurs="unbounded"/>
  <xs:element name="Data" type="xs:hexBinary"/>
  <xs:element name="Optional" type="xs:hexBinary" minOccurs="0"/>
  <xs:element name="Hash" type="uci:Digest" minOccurs="0"/>
  <xs:element name="Blob" type="uci:Blob"/>
  <xs:element name="Required" type="xs:float"/>
  <xs:element name="Checked" type="uci:TargetGet"/>
  <xs:element name="Samples" type="xs:float" minOccurs="0" maxOccurs="3"/>
 </xs:sequence></xs:complexType>
 <xs:complexType name="ArraySample"><xs:choice>
  <xs:element name="Nested" type="uci:PathLength"/>
  <xs:element name="Enabled" type="xs:boolean"/>
 </xs:choice></xs:complexType>
 <xs:complexType name="Mixed"><xs:sequence>
  <xs:element name="Picks" type="uci:ArraySample" minOccurs="1" maxOccurs="3"/>
 </xs:sequence></xs:complexType>
 <xs:element name="BinaryFloatNotice" type="uci:Mixed" uci:version="001.000.000.000"/>
</xs:schema>