<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
 <xs:complexType name="Details"><xs:sequence>
  <xs:element name="Observed" type="xs:dateTime"/>
  <xs:element name="Elapsed" type="xs:duration"/>
 </xs:sequence></xs:complexType>
 <xs:simpleType name="Mode"><xs:restriction base="xs:string">
  <xs:enumeration value="online"/><xs:enumeration value="offline"/>
 </xs:restriction></xs:simpleType>
 <xs:complexType name="Selection"><xs:choice>
  <xs:element name="Enabled" type="xs:boolean"/>
  <xs:element name="Nested" type="uci:Details"/>
  <xs:element name="State" type="uci:Mode"/>
 </xs:choice></xs:complexType>
 <xs:complexType name="RepeatedPayload"><xs:sequence>
  <xs:element name="Bounded" type="uci:Selection" minOccurs="0" maxOccurs="3"/>
  <xs:element name="PositiveBounded" type="uci:Selection" minOccurs="1" maxOccurs="3"/>
  <xs:element name="Unbounded" type="uci:Selection" minOccurs="0" maxOccurs="unbounded"/>
  <xs:element name="PositiveUnbounded" type="uci:Selection" minOccurs="2" maxOccurs="unbounded"/>
  <xs:element name="Single" type="uci:Selection"/>
 </xs:sequence></xs:complexType>
 <xs:element name="RepeatedNotice" type="uci:RepeatedPayload" uci:version="001.000.000.000"/>
</xs:schema>