<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
 <xs:simpleType name="Instant"><xs:restriction base="xs:dateTime">
  <xs:pattern value=".+Z"/>
 </xs:restriction></xs:simpleType>
 <xs:simpleType name="Span"><xs:restriction base="xs:duration"/></xs:simpleType>
 <xs:complexType name="Base"><xs:sequence>
  <xs:element name="Inherited" type="uci:Instant"/>
  <xs:element name="InheritedSpan" type="uci:Span"/>
 </xs:sequence></xs:complexType>
 <xs:complexType name="Details"><xs:sequence>
  <xs:element name="Observed" type="uci:Instant"/>
  <xs:element name="Local" type="xs:dateTime"/>
  <xs:element name="Span" type="uci:Span"/>
  <xs:element name="DirectSpan" type="xs:duration"/>
 </xs:sequence></xs:complexType>
 <xs:complexType name="Selection"><xs:choice>
  <xs:element name="Nested" type="uci:Details"/>
  <xs:element name="Enabled" type="xs:boolean"/>
 </xs:choice></xs:complexType>
 <xs:complexType name="CombinedPayload"><xs:complexContent><xs:extension base="uci:Base"><xs:sequence>
  <xs:element name="Direct" type="xs:dateTime"/>
  <xs:element name="DirectSpan" type="xs:duration"/>
  <xs:element name="OptionalSpan" type="uci:Span" minOccurs="0"/>
  <xs:element name="OptionalDirectSpan" type="xs:duration" minOccurs="0"/>
  <xs:element name="AbsentSpan" type="uci:Span" minOccurs="0"/>
  <xs:element name="AbsentDirectSpan" type="xs:duration" minOccurs="0"/>
  <xs:element name="Optional" type="xs:dateTime" minOccurs="0"/>
  <xs:element name="NamedOptional" type="uci:Instant" minOccurs="0"/>
  <xs:element name="Child" type="uci:Details"/>
  <xs:element name="Pick" type="uci:Selection"/>
  <xs:element name="Values" type="xs:byte" minOccurs="0" maxOccurs="3"/>
  <xs:element name="Rows" type="uci:Details" minOccurs="0" maxOccurs="unbounded"/>
  <xs:element name="BoundedRows" type="uci:Details" minOccurs="1" maxOccurs="2"/>
  <xs:element name="RequiredRows" type="uci:Details" minOccurs="1" maxOccurs="unbounded"/>
 </xs:sequence></xs:extension></xs:complexContent></xs:complexType>
 <xs:element name="CombinedNotice" type="uci:CombinedPayload" uci:version="001.000.000.000"/>
</xs:schema>
