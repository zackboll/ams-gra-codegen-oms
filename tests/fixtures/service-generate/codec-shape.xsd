<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s="urn:shape"
           xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
           targetNamespace="urn:shape"
           elementFormDefault="qualified"
           version="000.1.0">
  <!-- SYNTHETIC Task 051 fixture. NOT UCI. A closed abstract value in a
       qualified NON-OAM namespace: "$type" is the concrete complexType's own
       QName in Clark notation, "{urn:shape}BoxShape" (OMSC-SPC-013 Rev B
       6.1.2), and every member key is "{urn:shape}...". -->
  <xs:complexType name="ShapeBase" abstract="true">
    <xs:sequence>
      <xs:element name="Tag" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="BoxShape">
    <xs:complexContent>
      <xs:extension base="s:ShapeBase">
        <xs:sequence>
          <xs:element name="Width" type="xs:int"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="CircleShape">
    <xs:complexContent>
      <xs:extension base="s:ShapeBase">
        <xs:sequence>
          <xs:element name="Radius" type="xs:int"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="ShapePayload">
    <xs:sequence>
      <xs:element name="Shape" type="s:ShapeBase"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ShapeNotice" type="s:ShapePayload" uci:version="001.000.000.000"/>
</xs:schema>
