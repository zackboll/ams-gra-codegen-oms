<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
           targetNamespace="https://www.vdl.afrl.af.mil/programs/oam"
           elementFormDefault="qualified"
           version="000.1.0">
  <!-- SYNTHETIC Task 058 codec fixture (OAM namespace). Every constrained
       String here is a pinned bounded-ASCII row under a non-UCI name:

         Marker     MarkerType   [a-zA-Z]{0}, length 0              (EmptyType shape)
         Tail       TailType     [A-Z0-9 ]{8}, length 8             (AircraftIdentifierType)
         Label      LabelType    [a-zA-Z0-9 \-_]{1,20}, 1..20       optional
         Markers    MarkerType   0..3 bounded repeated zero-length values
         Codes      CodeType     [a-zA-Z0-9]{4}, length 4, 0..unbounded
         Pick       PickChoice   Choice: Launch ([A-Z]{1,3}) | Empty (MarkerType)

       OMSC-SPC-013 Rev B 6.1.4 case 5: xs:string is a JSON string whose
       characters are the XML lexical value (6.1.5.4). BoundedNotice is both
       subscribed and published on one topic so a CAL server loops it back. -->
  <xs:simpleType name="MarkerType">
    <xs:restriction base="xs:string">
      <xs:length value="0"/>
      <xs:pattern value="[a-zA-Z]{0}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TailType">
    <xs:restriction base="xs:string">
      <xs:length value="8"/>
      <xs:pattern value="[A-Z0-9&#x20;]{8}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="LabelType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="20"/>
      <xs:pattern value="[a-zA-Z0-9&#x20;\-_]{1,20}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CodeType">
    <xs:restriction base="xs:string">
      <xs:length value="4"/>
      <xs:pattern value="[a-zA-Z0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="LaunchType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="3"/>
      <xs:pattern value="[A-Z]{1,3}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="PickChoice">
    <xs:choice>
      <xs:element name="Launch" type="uci:LaunchType"/>
      <xs:element name="Empty" type="uci:MarkerType"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="BoundedPayload">
    <xs:sequence>
      <xs:element name="Marker" type="uci:MarkerType"/>
      <xs:element name="Tail" type="uci:TailType"/>
      <xs:element name="Label" type="uci:LabelType" minOccurs="0"/>
      <xs:element name="Markers" type="uci:MarkerType" minOccurs="0" maxOccurs="3"/>
      <xs:element name="Codes" type="uci:CodeType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Pick" type="uci:PickChoice"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="BoundedNotice" type="uci:BoundedPayload" uci:version="001.000.000.000"/>
</xs:schema>
