<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam" targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
  <xs:simpleType name="Serial"><xs:restriction base="xs:int"><xs:minInclusive value="1"/><xs:maxInclusive value="999"/><xs:pattern value="[0-9]{1,3}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Renamed"><xs:restriction base="xs:int"><xs:minInclusive value="1"/><xs:maxInclusive value="999"/><xs:pattern value="[0-9]{1,3}"/></xs:restriction></xs:simpleType>
  <xs:complexType name="SerialPayload"><xs:sequence>
    <xs:element name="Required" type="uci:Serial"/>
    <xs:element name="Optional" type="uci:Renamed" minOccurs="0"/>
    <xs:element name="Bounded" type="uci:Serial" minOccurs="0" maxOccurs="3"/>
    <xs:element name="Unbounded" type="uci:Serial" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Selection" type="uci:SerialPick"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="SerialPick"><xs:choice><xs:element name="Number" type="uci:Serial"/><xs:element name="Text" type="xs:string"/></xs:choice></xs:complexType>
  <xs:element name="SerialNotice" type="uci:SerialPayload" uci:version="000.000.000.000"/>
</xs:schema>