<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
           targetNamespace="https://www.vdl.afrl.af.mil/programs/oam"
           elementFormDefault="qualified"
           version="000.1.0">
  <!-- SYNTHETIC Task 049 fixture. This is NOT UCI, although it uses the OAM
       target namespace so that LA-CAL names are bare local names
       (OMSC-SPC-013 Rev B section 6.1.1): "MessageA", not "{...}MessageA".

         MessageA -> SharedPayload
         MessageB -> SharedPayload

       It is small enough for the unmodified pinned Sleet server to load as
       its schema_path (version attribute 000.1.0), which is how the real
       Sleet integration in docs/task-049-rust-la-cal-runtime.md runs. -->
  <xs:complexType name="SharedPayload">
    <xs:sequence>
      <xs:element name="Count" type="xs:int"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="MessageA" type="uci:SharedPayload" uci:version="001.000.000.000"/>
  <xs:element name="MessageB" type="uci:SharedPayload" uci:version="001.000.000.000"/>
</xs:schema>
