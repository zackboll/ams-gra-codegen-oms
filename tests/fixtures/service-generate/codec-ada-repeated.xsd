<?xml version="1.0" encoding="UTF-8"?>
<!-- Task 089: concrete Record members only; qualified OAM wire names. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
           targetNamespace="https://www.vdl.afrl.af.mil/programs/oam"
           elementFormDefault="qualified">
  <xs:simpleType name="Label"><xs:restriction base="xs:string">
    <xs:minLength value="1"/><xs:maxLength value="32"/>
    <xs:pattern value="[&#x20;-&#x7E;]{1,32}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="SignalCode"><xs:restriction base="xs:string">
    <xs:enumeration value="NORMAL"/><xs:enumeration value="5G"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="Details"><xs:sequence>
    <xs:element name="Label" type="uci:Label"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Base"><xs:sequence>
    <xs:element name="Inherited" type="uci:Label" minOccurs="0" maxOccurs="3"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="RepeatedPayload"><xs:complexContent><xs:extension base="uci:Base"><xs:sequence>
    <xs:element name="begin" type="uci:Label" minOccurs="0" maxOccurs="3"/>
    <xs:element name="Span" type="uci:Label" minOccurs="2" maxOccurs="3"/>
    <xs:element name="Pair" type="uci:Details" minOccurs="2" maxOccurs="2"/>
    <xs:element name="Words" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="RequiredLabels" type="uci:Label" minOccurs="2" maxOccurs="unbounded"/>
    <xs:element name="Signals" type="uci:SignalCode" minOccurs="0" maxOccurs="3"/>
    <xs:element name="Signed" type="xs:byte" minOccurs="0" maxOccurs="3"/>
    <xs:element name="Unsigned" type="xs:unsignedByte" minOccurs="0" maxOccurs="3"/>
    <xs:element name="Flags" type="xs:boolean" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="Details" type="uci:Details" minOccurs="0" maxOccurs="unbounded"/>
  </xs:sequence></xs:extension></xs:complexContent></xs:complexType>
  <xs:element name="RepeatedNotice" type="uci:RepeatedPayload" uci:version="001.000.000.000"/>
  <xs:element name="RepeatedEcho" type="uci:RepeatedPayload" uci:version="001.000.000.000"/>
</xs:schema>