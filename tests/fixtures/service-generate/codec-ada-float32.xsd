<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
 targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
 <xs:simpleType name="Unconstrained"><xs:restriction base="xs:float"/></xs:simpleType>
 <xs:simpleType name="ClosedRange"><xs:restriction base="xs:float">
  <xs:minInclusive value="-1"/><xs:maxInclusive value="1"/>
 </xs:restriction></xs:simpleType>
 <xs:simpleType name="OpenRange"><xs:restriction base="xs:float">
  <xs:minExclusive value="0"/><xs:maxExclusive value="2"/>
 </xs:restriction></xs:simpleType>
 <xs:simpleType name="LowerRange"><xs:restriction base="xs:float">
  <xs:minInclusive value="0"/>
 </xs:restriction></xs:simpleType>
 <xs:complexType name="Nested"><xs:sequence>
  <xs:element name="Value" type="xs:float"/>
 </xs:sequence></xs:complexType>
 <xs:complexType name="Selection"><xs:choice>
  <xs:element name="Record" type="uci:Nested"/>
  <xs:element name="Integer" type="xs:int"/>
 </xs:choice></xs:complexType>
 <xs:complexType name="FloatPayload"><xs:sequence>
  <xs:element name="Required" type="xs:float"/>
  <xs:element name="Optional" type="xs:float" minOccurs="0"/>
  <xs:element name="Named" type="uci:Unconstrained"/>
  <xs:element name="Closed" type="uci:ClosedRange"/>
  <xs:element name="Open" type="uci:OpenRange"/>
  <xs:element name="Lower" type="uci:LowerRange"/>
  <xs:element name="Bounded" type="xs:float" minOccurs="0" maxOccurs="3"/>
  <xs:element name="Unbounded" type="xs:float" minOccurs="2" maxOccurs="unbounded"/>
  <xs:element name="NamedRepeated" type="uci:ClosedRange" minOccurs="1" maxOccurs="3"/>
  <xs:element name="Nested" type="uci:Nested"/>
  <xs:element name="Choice" type="uci:Selection"/>
  <xs:element name="Count" type="xs:int"/>
  <xs:element name="Enabled" type="xs:boolean"/>
  <xs:element name="Observed" type="xs:dateTime"/>
  <xs:element name="Elapsed" type="xs:duration"/>
 </xs:sequence></xs:complexType>
 <xs:element name="FloatNotice" type="uci:FloatPayload" uci:version="001.000.000.000"/>
</xs:schema>