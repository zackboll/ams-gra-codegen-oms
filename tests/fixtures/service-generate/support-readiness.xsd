<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test"
           xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam"
           targetNamespace="urn:test"
           elementFormDefault="qualified"
           version="000.1.0">
  <!-- Task 056 readiness / generated-support parity fixture.

       NOT UCI. A tiny stand-in that separates the contract-selected semantic
       closure from the generated-support closure:

         HolderReport -> Holder { Value : Base }        (Base abstract)
           Base descendants (closed-schema support):
             ConcreteGood                               renderable
             ConcreteBad { Elapsed : BadTime }          NOT renderable
           BadTime  named xs:time restriction; no backend renders it

       Task 057 test-fixture adaptation: the intentionally unsupported support
       primitive was xs:duration (BadDuration/UnrelatedDuration). Task 057
       makes zero-facet xs:duration renderable, which would silently turn this
       fixture READY and stop it testing Task 056. xs:time is still
       unsupported, so it now plays that role; Task 056 semantics are
       unchanged.

       The contract-selected closure of HolderReport is Holder + Base, both
       individually renderable. Generation additionally needs ConcreteGood,
       ConcreteBad and BadTime (schema order: BadTime, ConcreteGood,
       ConcreteBad). Before Task 056 readiness said READY and the backend then
       failed; now readiness is NOT READY on the generated-support surface.

       Controls in the same schema set:

         SelectedBadReport -> SelectedBad { Elapsed : BadTime }
             the unsupported declaration is SELECTED (ordinary NOT READY)
         GoodHolderReport -> GoodHolder { Value : GoodBase } (GoodBase abstract)
             every support descendant renders, while BadTime and
             UnrelatedTime stay unselected and unrelated (READY)
         UnrelatedTime  xs:time nothing reaches -->
  <xs:simpleType name="BadTime">
    <xs:restriction base="xs:time"/>
  </xs:simpleType>
  <xs:complexType name="Base" abstract="true">
    <xs:sequence>
      <xs:element name="Id" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ConcreteGood">
    <xs:complexContent>
      <xs:extension base="t:Base">
        <xs:sequence>
          <xs:element name="GoodField" type="xs:int"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="ConcreteBad">
    <xs:complexContent>
      <xs:extension base="t:Base">
        <xs:sequence>
          <xs:element name="Elapsed" type="t:BadTime"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Holder">
    <xs:sequence>
      <xs:element name="Value" type="t:Base"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="SelectedBad">
    <xs:sequence>
      <xs:element name="Elapsed" type="t:BadTime"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="GoodBase" abstract="true">
    <xs:sequence>
      <xs:element name="Label" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="GoodConcreteA">
    <xs:complexContent>
      <xs:extension base="t:GoodBase">
        <xs:sequence>
          <xs:element name="Count" type="xs:int"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="GoodConcreteB">
    <xs:complexContent>
      <xs:extension base="t:GoodBase">
        <xs:sequence>
          <xs:element name="Flag" type="xs:boolean"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="GoodHolder">
    <xs:sequence>
      <xs:element name="Value" type="t:GoodBase"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="UnrelatedTime">
    <xs:restriction base="xs:time"/>
  </xs:simpleType>
  <xs:element name="HolderReport" type="t:Holder" uci:version="001.000.000.000"/>
  <xs:element name="SelectedBadReport" type="t:SelectedBad" uci:version="001.000.000.000"/>
  <xs:element name="GoodHolderReport" type="t:GoodHolder" uci:version="001.000.000.000"/>
</xs:schema>
