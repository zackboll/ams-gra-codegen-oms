<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:uci="https://www.vdl.afrl.af.mil/programs/oam" targetNamespace="https://www.vdl.afrl.af.mil/programs/oam" elementFormDefault="qualified">
  <xs:simpleType name="NotationType"><xs:restriction base="xs:string"><xs:minLength value="4"/><xs:maxLength value="5"/><xs:pattern value="[A-Z0-9]{5}|UNKN|NONE"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="OriginType"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="2"/><xs:pattern value="[A-Z][A-Z]|[E]|[\-]"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="AddressType"><xs:restriction base="xs:string"><xs:minLength value="7"/><xs:maxLength value="15"/><xs:pattern value="(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])"/></xs:restriction></xs:simpleType>
  <xs:complexType name="AlternatingPayload"><xs:sequence>
    <xs:element name="Notation" type="uci:NotationType"/>
    <xs:element name="Origin" type="uci:OriginType"/>
    <xs:element name="Address" type="uci:AddressType"/>
  </xs:sequence></xs:complexType>
  <xs:element name="AlternatingNotice" type="uci:AlternatingPayload" uci:version="001.000.000.000"/>
</xs:schema>